# ===================================================================
# KONFIGURASI SERVER UTAMA (EXPRESS.JS)
# ===================================================================
PORT=3000
JWT_SECRET=your-secret-key-change-in-production
SESSION_SECRET=project01-super-secret-session-key

# ===================================================================
# MODE PENGUJIAN WHATSAPP (SAFETY FIRST)
# ===================================================================
# true  : Mengirim pesan WhatsApp sungguhan melalui container WAHA
# false : MODE SIMULASI (AMAN). Pesan hanya dicetak rapi di terminal/console
#         Sangat direkomendasikan saat testing awal tanpa nomor WA pribadi terhubung.
ENABLE_WHATSAPP=false

# ===================================================================
# KONFIGURASI WAHA CORE (DOCKER LOCALHOST)
# ===================================================================
# Alamat WAHA lokal (hanya diakses via 127.0.0.1)
WAHA_BASE_URL=http://127.0.0.1:3008

# API Key untuk mengamankan endpoint WAHA
WAHA_API_KEY=waha_secret_key_proyek01_2026

# Nama sesi WAHA default
WAHA_SESSION=default

# Batas waktu permintaan HTTP ke WAHA dalam milidetik (mencegah Express hang)
WAHA_TIMEOUT_MS=8000

# Kredensial login Dashboard/Swagger WAHA di browser
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=AdminSecurePassword123!

# Nomor WhatsApp Admin untuk notifikasi Server Loss / Watchdog (format: 628...)
WA_ADMIN_PHONE=6281234567890
