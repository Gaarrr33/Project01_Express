<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Data Mahasiswa</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container my-5">
    <h1 class="mb-4">Data Mahasiswa</h1>
    <a href="/biodata/create" class="btn btn-primary mb-3">Tambah Mahasiswa</a>
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle text-center">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>NRP</th>
                    <th>Nama</th>
                    <th>Jenis Kelamin</th>
                    <th>Foto</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% data.forEach(m => { %>
                <tr>
                    <td><%= m.id_mahasiswa %></td>
                    <td><%= m.nrp %></td>
                    <td><%= m.nama %></td>
                    <td><%= m.jenis_kelamin %></td>
                    <td><img src="/uploads/<%= m.foto %>" width="50" class="rounded"></td>
                    <td>
                        <a href="/biodata/edit/<%= m.id_mahasiswa %>" class="btn btn-sm btn-warning">Edit</a>
                        <a href="/biodata/delete/<%= m.id_mahasiswa %>" class="btn btn-sm btn-danger" onclick="return confirm('Yakin hapus?')">Hapus</a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
</body>
</html>